# EvidenceGraphAI Environment Variables

# Application Settings
APP_NAME=EvidenceGraphAI
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword123
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# PostgreSQL Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=evidencegraphai
POSTGRES_USER=evidencegraphai
POSTGRES_PASSWORD=devpassword123

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# MinIO Settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evidencegraphai-artifacts
MINIO_SECURE=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000

# Observability Settings
METRICS_ENABLED=true
METRICS_PORT=8000

# --- Phase 1 Settings ---

# Provenance Settings
# If true, source_agent must be in KNOWN_AGENTS (strict allowlist enforcement)
PROVENANCE_STRICT_MODE=false
# Comma-separated list of known/registered agent names (used when strict mode is on)
KNOWN_AGENTS=system,manual

# Developer Viewer Settings
# Set to false to completely disable the viewer and /graph/export in production
DEV_VIEWER_ENABLED=true
# Set to true ONLY for non-production debugging in a trusted network — never expose publicly
DEV_VIEWER_ALLOW_REMOTE=false

# Test Database Settings
# Optional: set a separate Neo4j database for integration tests to avoid polluting dev data
NEO4J_TEST_DATABASE=neo4j

# --- Phase 2 Settings ---

# Ingestion Settings
INGESTION_MAX_FILE_SIZE_MB=2048
INGESTION_ALLOWED_TYPES=pcap,json,pe,elf,apk,text,pdf,cert_pem,cert_der
INGESTION_ANONYMIZE_PCAP=true
INGESTION_ANONYMIZE_LOGS=true

# Manifest Settings
MANIFEST_SIGNING_KEY=dev-insecure-manifest-signing-key-32b
MANIFEST_GENERATOR_IDENTITY=EvidenceGraphAI

# --- Phase 3 Settings ---

# NVD API Settings
# Obtain from: https://nvd.nist.gov/developers/request-an-api-key
# Without a key: 5 requests per 30 seconds. With key: 50 requests per 30 seconds.
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_CACHE_TTL_DAYS=7
NVD_REQUEST_TIMEOUT=30
NVD_MAX_RETRIES=3

# Sandbox Settings
SANDBOX_COMPOSE_FILE=infra/sandbox/docker-compose.yml
SANDBOX_REPLAY_TIMEOUT=300
SANDBOX_TELEMETRY_DIR=/tmp/evidencegraphai/sandbox

# Agent Registry (Phase 3 agents added to allowlist)
KNOWN_AGENTS=system,manual,vulnerability_intelligence,threat_reconstruction,sandbox_replay,attack_mapper
